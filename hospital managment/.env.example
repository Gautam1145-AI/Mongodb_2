# MongoDB Connection URI (Local or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/HospitalDB
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/HospitalDB?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/HospitalDB
DB_NAME=HospitalDB
PORT=5000
SECRET_KEY=hospital-management-secret-key-2026
