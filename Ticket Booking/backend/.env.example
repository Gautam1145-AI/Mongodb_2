# ==============================================================================
# Spring Boot Backend Environment Variables Template
# Copy this file to .env or set environment variables in your deployment host
# ==============================================================================

# Server Port
PORT=8080

# MongoDB Replica Set / Atlas URI (Requires replica set for ACID multi-doc transactions)
# Local Replica Set:
MONGODB_URI=mongodb://127.0.0.1:27017/ticket_booking?replicaSet=rs0
# MongoDB Atlas Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ticket_booking?retryWrites=true&w=majority

MONGODB_DATABASE=ticket_booking

# JWT Security Configuration (256-bit secret)
JWT_SECRET=4c8b2f91a03e456d8c9b2f91a03e456d8c9b2f91a03e456d8c9b2f91a03e456d
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Business Policy Configurations
HOLD_DURATION_MINUTES=10
CANCELLATION_CUTOFF_HOURS=2

